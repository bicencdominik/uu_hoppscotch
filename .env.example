#-----------------------Backend Config------------------------------#
# Prisma Config
DATABASE_URL=postgresql://postgres:testpass@hoppscotch-db:5432/hoppscotch

# Sensitive Data Encryption Key while storing in Database (32 character)
DATA_ENCRYPTION_KEY=data encryption key with 32 char

# Whitelisted origins for the Hoppscotch App.
# This list controls which origins can interact with the app through cross-origin comms.
# - localhost ports (3170, 3000, 3100): app, backend, development servers and services
# - app://localhost_3200: Bundle server origin identifier
#   NOTE: `3200` here refers to the bundle server (port 3200) that provides the bundles,
#   NOT where the app runs. The app itself uses the `app://` protocol with dynamic
#   bundle names like `app://{bundle-name}/`
WHITELISTED_ORIGINS=http://localhost:3170,http://localhost:3000,http://localhost:3100,app://localhost_3200,app://hoppscotch,app://hoppscotch_localhost,http://app.hoppscotch_localhost

# Optional: Default proxy URL offered to clients when proxying is enabled.
# Clients control whether requests are proxied via the in-app toggle; this only
# sets which URL they default to.
#
# AIR-GAPPED NOTE: the upstream default is https://proxy.hoppscotch.io, which is
# unreachable here. Point this at an internal proxy if you need the Proxy
# interceptor, or leave it commented out and do not use that interceptor -- the
# default interceptor is the browser, so proxying is opt-in either way. Note that
# clearing this does NOT disable the option: the frontend falls back to the public
# URL when the value is missing or fails its regex (see helpers/proxyUrl.ts).
# PROXY_APP_URL="http://proxy.internal:8080"

# If true, the client’s IP address is understood as the left-most entry in the X-Forwarded-For header
TRUST_PROXY=false

#-----------------------Local Password Auth--------------------------#

# Auth providers offered by this instance. For an air-gapped deployment set this
# to PASSWORD only: SSO needs an identity provider and EMAIL needs a mail server,
# neither of which exists on an isolated network.
# Setting this also marks onboarding complete, so the setup wizard is skipped.
VITE_ALLOWED_AUTH_PROVIDERS=PASSWORD

# Initial administrator, created once on first boot if it does not already exist.
# Both must be set together. The account is NOT updated on later boots -- rotate
# the password with the create-user CLI instead:
#   docker exec -it <container> node /dist/backend/dist/src/cli/create-user.js admin --update
HOPP_INITIAL_ADMIN_USER=admin
HOPP_INITIAL_ADMIN_PASSWORD=change-me-before-deploying

#-----------------------Frontend Config------------------------------#

# Base URLs
VITE_BASE_URL=http://localhost:3000
VITE_SHORTCODE_BASE_URL=http://localhost:3000
VITE_ADMIN_URL=http://localhost:3100

# Backend URLs
#
# AIR-GAPPED NOTE: these three must be present AND non-empty at build/runtime.
# The frontend falls back with `??`, which catches an unset variable but NOT an
# empty string -- so a blank value yields a broken relative URL, and a missing
# one sends every page load to https://api.hoppscotch.io. Assert them in your
# deploy check. The same applies to VITE_SHORTCODE_BASE_URL above, which falls
# back to https://hopp.sh.
VITE_BACKEND_GQL_URL=http://localhost:3170/graphql
VITE_BACKEND_WS_URL=ws://localhost:3170/graphql
VITE_BACKEND_API_URL=http://localhost:3170/v1

# Terms Of Service And Privacy Policy Links (Optional)
#
# AIR-GAPPED NOTE: left unset on purpose. The login modal renders this footer only
# when BOTH are non-empty, so leaving them blank removes two dead links with no
# code change. Set them to internal URLs if your deployment needs them.
# VITE_APP_TOS_LINK=
# VITE_APP_PRIVACY_POLICY_LINK=

# Set default to null as https://proxy.hoppscotch.io/ doesn't require an access token
VITE_PROXYSCOTCH_ACCESS_TOKEN=

# Set to `true` for subpath based access
ENABLE_SUBPATH_BASED_ACCESS=false

#-----------------------Embedded Postgres (aio-standalone image only)------#

# Only used by the `aio-standalone` Docker target (`docker build --target
# aio-standalone`), which bundles Postgres in the same container so the whole
# stack runs as one self-contained image with no external database. Ignored
# by every other target/service, which keep using DATABASE_URL above as-is.
#
# When set, DATABASE_URL is derived automatically from these three vars at
# startup (postgresql://<user>:<password>@127.0.0.1:5432/<db>) -- do not set
# DATABASE_URL separately for this image, it will be overwritten.
# HOPP_EMBEDDED_POSTGRES=true

# Required (no default) when HOPP_EMBEDDED_POSTGRES=true.
# HOPP_EMBEDDED_DB_PASSWORD=change-me-before-deploying

# Optional, both default to "hoppscotch".
# HOPP_EMBEDDED_DB_USER=hoppscotch
# HOPP_EMBEDDED_DB_NAME=hoppscotch

# Mount a persistent volume at this path (or override it) so the database
# survives container restarts -- the container restarts itself once on first
# boot by design (see HOPP_INITIAL_ADMIN_USER above), and every subsequent
# restart would silently re-initialize an empty database without one.
# PGDATA=/data/postgres

#-----------------------Container Runtime Config---------------------#

# Caddy's in-container HTTP port (default 80). Set a free port (e.g. 8000) to run
# under a non-root UID like OpenShift (ports < 1024 need root or CAP_NET_BIND_SERVICE),
# and update your published mapping too. Avoid internal ports 8080, 3200, 3000, 3100,
# 3170. Non-root runs expect GID 0. On the AIO image this applies only when
# ENABLE_SUBPATH_BASED_ACCESS=true; the legacy HOPP_AIO_ALTERNATE_PORT is honoured
# there as a fallback.
# HOPP_ALTERNATE_PORT=8000
